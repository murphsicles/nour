// test_wallet.z — Wallet module tests
// Tests for BIP-39 mnemonics, BIP-32 extended keys, hardened derivation, HMAC-SHA512.
// Uses inline implementations. Prints PASS/FAIL per test with summary.

use std.crypto

// ─── Constants ─────────────────────────────────────────────────────────────

const HARDENED_KEY: u32 = 0x80000000
const WORDS_IN_WORDLIST: i64 = 2048

// ─── Inline HMAC-SHA512 (RFC 2104) ─────────────────────────────────────────

fn hmac_sha512(key: [u8], data: [u8]) -> [u8; 64] {
    let block_size: i64 = 128;
    let mut k: [u8; 128] = [0; 128];
    let k_len = len(key);

    if k_len > block_size {
        let hash = crypto::sha512(key);
        let mut i: i64 = 0;
        while i < 64 { k[i] = hash[i]; i += 1; }
    } else {
        let mut i: i64 = 0;
        while i < k_len { k[i] = key[i]; i += 1; }
    }

    let mut i_key: [u8; 128] = [0; 128];
    let mut o_key: [u8; 128] = [0; 128];
    let mut i: i64 = 0;
    while i < block_size {
        i_key[i] = k[i] ^ 0x36;
        o_key[i] = k[i] ^ 0x5c;
        i += 1;
    }

    let data_len = len(data);
    let mut inner_input: [u8; 4096] = [0; 4096];
    let mut ii: i64 = 0;
    while ii < block_size { inner_input[ii] = i_key[ii]; ii += 1; }
    let mut di: i64 = 0;
    while di < data_len { inner_input[block_size + di] = data[di]; di += 1; }

    let inner_hash = crypto::sha512(inner_input[0..block_size + data_len]);

    let mut outer_input: [u8; 4096] = [0; 4096];
    let mut oi: i64 = 0;
    while oi < block_size { outer_input[oi] = o_key[oi]; oi += 1; }
    let mut hi: i64 = 0;
    while hi < 64 { outer_input[block_size + hi] = inner_hash[hi]; hi += 1; }

    return crypto::sha512(outer_input[0..block_size + 64]);
}

// ─── Inline ExtendedKey ────────────────────────────────────────────────────

const MAINNET_PRIVATE_EXTENDED_KEY: [u8; 4] = [0x04, 0x88, 0xAD, 0xE4]

fn u32_to_be_bytes(val: u32) -> (u8, u8, u8, u8) {
    return ((val >> 24) as u8, (val >> 16) as u8, (val >> 8) as u8, val as u8);
}

fn copy_32(src: [u8], soff: i64) -> [u8; 32] {
    let mut dst: [u8; 32] = [0; 32];
    let mut i: i64 = 0;
    while i < 32 { dst[i] = src[soff + i]; i += 1; }
    return dst;
}

fn extended_key_from_seed(seed: [u8]) -> [u8; 78] {
    let seed_str: [u8] = "Bitcoin seed" as [u8];
    let hmac_result = hmac_sha512(seed_str, seed);
    let il: [u8; 32] = copy_32(hmac_result, 0);
    let chain_code: [u8; 32] = copy_32(hmac_result, 32);

    let mut key: [u8; 78] = [0; 78];
    // Version: mainnet private (4 bytes)
    key[0] = 0x04; key[1] = 0x88; key[2] = 0xAD; key[3] = 0xE4;
    // Depth: 0
    key[4] = 0;
    // Parent fingerprint (bytes 5-8): 0 for master
    // Child number (bytes 9-12): 0 for master
    // Chain code (bytes 13-44): 32 bytes
    let mut ci: i64 = 0;
    while ci < 32 {
        key[13 + ci] = chain_code[ci];
        ci += 1;
    }
    // Key data (bytes 45-77): 0x00 prefix + 32 bytes secret
    key[45] = 0;
    let mut si: i64 = 0;
    while si < 32 {
        key[46 + si] = il[si];
        si += 1;
    }

    return key;
}

// ─── Inline BIP-39 ─────────────────────────────────────────────────────────

fn bits_extract(data: [u8], bit_start: i64, count: i64) -> u16 {
    let mut result: u16 = 0;
    let mut i: i64 = 0;
    while i < count {
        let byte_idx = (bit_start + i) / 8;
        let bit_idx = (bit_start + i) % 8;
        let bit = (data[byte_idx] >> (7 - bit_idx)) & 1;
        result = (result << 1) | (bit as u16);
        i += 1;
    }
    return result;
}

