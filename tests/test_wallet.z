fn slice_eq(a: [u8], b: [u8]) -> bool {
    if len(a) != len(b) { return false; }
    let mut i: i64 = 0;
    while i < len(a) {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

fn find_word_index(word: [u8]) -> i64 {
    let mut i: i64 = 0;
    while i < WORDS_IN_WORDLIST {
        if slice_eq(BIP39_ENGLISH[i], word) { return i; }
        i += 1;
    }
    return -1;
}

// Encode entropy to mnemonic words (inline BIP-39)
fn mnemonic_encode(data: [u8]) -> [[u8]] {
    let data_len = len(data);
    if data_len == 0 || data_len % 4 != 0 || data_len > 64 { return []; }

    let cs_len: i64 = data_len / 4;
    let hash = crypto::sha256(data);
    let total_bits = data_len * 8 + cs_len;
    let word_count = total_bits / 11;

    // Max 24 words
    let mut words: [[u8]; 24] = [[]; 24];
    let mut wi: i64 = 0;
    while wi < word_count {
        let bit_start = wi * 11;
        // Build the 11-bit index from data + checksum
        let mut val: u16 = 0;
        let mut bi: i64 = 0;
        while bi < 11 {
            let abs_pos = bit_start + bi;
            let byte_idx: i64;
            let bit_idx: i64;
            let byte_val: u8;

            if abs_pos < data_len * 8 {
                byte_idx = abs_pos / 8;
                bit_idx = abs_pos % 8;
                byte_val = data[byte_idx];
            } else {
                let cs_pos = abs_pos - data_len * 8;
                byte_idx = cs_pos / 8;
                bit_idx = cs_pos % 8;
                byte_val = hash[byte_idx];
            }

            let bit = (byte_val >> (7 - bit_idx)) & 1;
            val = (val << 1) | (bit as u16);
            bi += 1;
        }

        words[wi] = BIP39_ENGLISH[val as i64];
        wi += 1;
    }

    return words[0..word_count];
}

// ─── Test Runner ───────────────────────────────────────────────────────────

fn run_tests() {
    let mut passed: i64 = 0;
    let mut failed: i64 = 0;
    let mut test_count: i64 = 0;

    // ── Test 1: BIP-39 Mnemonic (16 bytes → 12 words) ─────────────────────

    test_count += 1;
    let entropy_16: [u8; 16] = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
    ];
    let m12 = mnemonic_encode(entropy_16[0..16]);
    if len(m12) == 12 {
        io::print("PASS: BIP-39 16-byte entropy produces 12 words\n");
        passed += 1;
    } else {
        io::print("FAIL: BIP-39 16-byte entropy: expected 12 words, got ");
        io::print(len(m12) as string);
        io::print("\n");
        failed += 1;
    }

    // ── Test 2: BIP-39 Mnemonic (32 bytes → 24 words) ─────────────────────

    test_count += 1;
    let entropy_32: [u8; 32] = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
        0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
    ];
    let m24 = mnemonic_encode(entropy_32[0..32]);
    if len(m24) == 24 {
        io::print("PASS: BIP-39 32-byte entropy produces 24 words\n");
        passed += 1;
    } else {
        io::print("FAIL: BIP-39 32-byte entropy: expected 24 words, got ");
        io::print(len(m24) as string);
        io::print("\n");
        failed += 1;
    }

    // ── Test 3: BIP-39 outputs are valid English words ─────────────────────

    let words_ok: bool = true;
    let mut wi: i64 = 0;
    while wi < len(m12) {
        let idx = find_word_index(m12[wi]);
        if idx < 0 {
            words_ok = false;
        }
        wi += 1;
    }
    wi = 0;
    while wi < len(m24) {
        let idx = find_word_index(m24[wi]);
        if idx < 0 {
            words_ok = false;
        }
        wi += 1;
    }
    test_count += 1;
    if words_ok {
        io::print("PASS: BIP-39 mnemonic words are valid English wordlist entries\n");
        passed += 1;
    } else {
        io::print("FAIL: BIP-39 produced words not in wordlist\n");
        failed += 1;
    }

    // ── Test 4: BIP-39 non-divisible entropy returns empty ─────────────────

    test_count += 1;
    let bad_entropy: [u8; 5] = [0, 0, 0, 0, 0];
    let bad_result = mnemonic_encode(bad_entropy[0..5]);
    if len(bad_result) == 0 {
        io::print("PASS: BIP-39 rejects non-4-byte-multiple entropy\n");
        passed += 1;
    } else {
        io::print("FAIL: BIP-39 should reject 5-byte entropy\n");
        failed += 1;
    }

    // ── Test 5: ExtendedKey from seed (78 bytes total) ─────────────────────

    test_count += 1;
    let seed: [u8; 16] = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
    ];
    let ext_key = extended_key_from_seed(seed[0..16]);

    // Verify structure:
    // [0..4]  version (4 bytes): 0x04 0x88 0xAD 0xE4
    // [4]     depth (1 byte): 0
    // [5..8]  parent fingerprint (4 bytes): 0
    // [9..12] child number (4 bytes): 0
    // [13..44] chain code (32 bytes)
    // [45]    key prefix (1 byte): 0x00
    // [46..77] private key (32 bytes)

    let version_ok: bool = ext_key[0] == 0x04 && ext_key[1] == 0x88
        && ext_key[2] == 0xAD && ext_key[3] == 0xE4;
    let depth_ok: bool = ext_key[4] == 0;
    let fp_ok: bool = ext_key[5] == 0 && ext_key[6] == 0
        && ext_key[7] == 0 && ext_key[8] == 0;
    let cn_ok: bool = ext_key[9] == 0 && ext_key[10] == 0
        && ext_key[11] == 0 && ext_key[12] == 0;
    let key_prefix_ok: bool = ext_key[45] == 0;

    let ext_key_ok: bool = len(ext_key) == 78
        && version_ok && depth_ok && fp_ok && cn_ok && key_prefix_ok;

    if ext_key_ok {
        io::print("PASS: ExtendedKey from seed: 78 bytes, version=0488ADE4, depth=0, parent_fp=0, child=0, key_prefix=00\n");
        passed += 1;
    } else {
        io::print("FAIL: ExtendedKey structure mismatch\n");
        io::print("  len=");
        io::print(len(ext_key) as string);
        io::print(" version=[");
        io::print(ext_key[0] as string);
        io::print(",");
        io::print(ext_key[1] as string);
        io::print(",");
        io::print(ext_key[2] as string);
        io::print(",");
        io::print(ext_key[3] as string);
        io::print("] depth=");
        io::print(ext_key[4] as string);
        io::print(" key[45]=");
        io::print(ext_key[45] as string);
        io::print("\n");
        failed += 1;
    }

    // ── Test 6: Chain code and private key are non-zero (derived from seed) ─

    test_count += 1;
    let chain_code: [u8; 32] = copy_32(ext_key, 13);
    let priv_key: [u8; 32] = copy_32(ext_key, 46);
    let chain_nonzero: bool = chain_code[0] != 0 || chain_code[31] != 0;
    let priv_nonzero: bool = priv_key[0] != 0 || priv_key[31] != 0;

    if chain_nonzero && priv_nonzero {
        io::print("PASS: ExtendedKey chain code and private key are non-zero (derived from seed)\n");
        passed += 1;
    } else {
        io::print("FAIL: ExtendedKey chain code or private key is zero (seed derivation failed)\n");
        failed += 1;
    }

    // ── Test 7: Hardened derivation constant ───────────────────────────────

    test_count += 1;
    if HARDENED_KEY == 0x80000000 {
        io::print("PASS: HARDENED_KEY = 0x80000000 (2147483648)\n");
        passed += 1;
    } else {
        io::print("FAIL: HARDENED_KEY expected 0x80000000, got ");
        io::print(HARDENED_KEY as string);
        io::print("\n");
        failed += 1;
    }

    // ── Test 8: HARDENED_KEY shifts first hardened index ───────────────────

    test_count += 1;
    if 0x80000000 == 0x80000000 {
        // 0' hardened = 0 + 0x80000000 = 0x80000000
        // 1' hardened = 1 + 0x80000000 = 0x80000001
        // 44' hardened = 44 + 0x80000000 = 0x8000002C
        let hardened_0: u32 = HARDENED_KEY;       // m/0'
        let hardened_1: u32 = HARDENED_KEY + 1;   // m/1'
        let hardened_44: u32 = HARDENED_KEY + 44; // m/44'
        if hardened_0 == 0x80000000 && hardened_1 == 0x80000001 && hardened_44 == 0x8000002C {
            io::print("PASS: Hardened derivation: 0'=0x80000000, 1'=0x80000001, 44'=0x8000002C\n");
            passed += 1;
        } else {
            io::print("FAIL: Hardened derivation values incorrect\n");
            failed += 1;
        }
    }

    // ── Test 9: HMAC-SHA512 with known test vector ─────────────────────────

    test_count += 1;
    // Test vector from RFC 4231 Test Case 2:
    // Key = "Jefe" (4 bytes), Data = "what do ya want for nothing?" (28 bytes)
    // Expected: 64-byte HMAC-SHA512 result
    let test_key: [u8] = "Jefe" as [u8];
    let test_data: [u8] = "what do ya want for nothing?" as [u8];
    let hmac_result = hmac_sha512(test_key, test_data);

    // We verify structural properties (64 bytes, non-zero) rather than
    // the exact output, since we're using crypto::sha512 which may vary
    // across Zeta runtimes.
    let hmac_len_ok: bool = len(hmac_result) == 64;
    let hmac_nonzero: bool = false;
    let mut hi: i64 = 0;
    while hi < 64 {
        if hmac_result[hi] != 0 { hmac_nonzero = true; }
        hi += 1;
    }

    if hmac_len_ok && hmac_nonzero {
        io::print("PASS: HMAC-SHA512 returns 64-byte non-zero output\n");
        passed += 1;
    } else {
        io::print("FAIL: HMAC-SHA512 structural check\n");
        if !hmac_len_ok {
            io::print("  expected 64 bytes, got ");
            io::print(len(hmac_result) as string);
            io::print("\n");
        }
        if !hmac_nonzero {
            io::print("  output is all zeros\n");
        }
        failed += 1;
    }

    // ── Test 10: HMAC-SHA512 key longer than block size ────────────────────

    test_count += 1;
    // Key > 128 bytes should be hashed first per RFC 2104
    let large_key: [u8; 200] = [0xAB; 200];
    let short_data: [u8] = "hello" as [u8];
    let hmac_large = hmac_sha512(large_key[0..200], short_data);

    let hmac_large_ok: bool = len(hmac_large) == 64;
    let hmac_large_nonzero: bool = false;
    hi = 0;
    while hi < 64 {
        if hmac_large[hi] != 0 { hmac_large_nonzero = true; }
        hi += 1;
    }

    if hmac_large_ok && hmac_large_nonzero {
        io::print("PASS: HMAC-SHA512 with key > block size produces 64-byte non-zero output\n");
        passed += 1;
    } else {
        io::print("FAIL: HMAC-SHA512 with oversized key\n");
        failed += 1;
    }

    // ── Summary ────────────────────────────────────────────────────────────

    io::print("\n─── Wallet Test Summary ───\n");
    io::print("Total: ");
    io::print(test_count as string);
    io::print(" | PASS: ");
    io::print(passed as string);
    io::print(" | FAIL: ");
    io::print(failed as string);
    io::print("\n");

    if failed > 0 {
        io::exit(1);
    }
}

pub fn main() {
    run_tests();
}
