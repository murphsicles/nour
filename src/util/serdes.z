// Binary serialization/deserialization helpers for Bitcoin SV objects.
// Provides low-level read/write functions for fixed-size byte arrays.

// Reads 16 bytes from a buffer at the given position.
// Returns (array, new_pos) on success, or an error if past buffer end.
fn read_16(buf: []u8, pos: i64) -> ([16]u8, i64) {
    if pos + 16 > len(buf) {
        return ([0u8; 16], -1);
    }
    let mut result: [16]u8 = [0u8; 16];
    let mut i: i64 = 0;
    while i < 16 {
        result[i] = buf[pos + i];
        i += 1;
    }
    return (result, pos + 16);
}

// Writes 16 bytes to a buffer at the given position.
// Returns new position or -1 if buffer too small.
fn write_16(data: [16]u8, buf: []u8, pos: i64) -> i64 {
    if pos + 16 > len(buf) {
        return -1;
    }
    let mut i: i64 = 0;
    while i < 16 {
        buf[pos + i] = data[i];
        i += 1;
    }
    return pos + 16;
}

// Reads 32 bytes from a buffer at the given position.
// Returns (array, new_pos) on success, or an error if past buffer end.
fn read_32(buf: []u8, pos: i64) -> ([32]u8, i64) {
    if pos + 32 > len(buf) {
        return ([0u8; 32], -1);
    }
    let mut result: [32]u8 = [0u8; 32];
    let mut i: i64 = 0;
    while i < 32 {
        result[i] = buf[pos + i];
        i += 1;
    }
    return (result, pos + 32);
}

// Writes 32 bytes to a buffer at the given position.
// Returns new position or -1 if buffer too small.
fn write_32(data: [32]u8, buf: []u8, pos: i64) -> i64 {
    if pos + 32 > len(buf) {
        return -1;
    }
    let mut i: i64 = 0;
    while i < 32 {
        buf[pos + i] = data[i];
        i += 1;
    }
    return pos + 32;
}
