// stack.z — Stack utilities for script numbers and booleans in Bitcoin SV consensus
// Provides consensus-correct operations for pushing/popping items.
// Numbers: [-2^31 + 1, 2^31 - 1], minimal (<=4 bytes), sign extend negative.
// Bools: Non-zero = true; minimal <=4 bytes.
// BigInts: LE bytes with optional sign bit on MSB.

const MAX_BOOL_LEN: i64 = 4;
const MAX_NUM_LEN: i64 = 4;
const NUM_RANGE: i64 = 1 << 31;

// Decodes a byte slice to bool (non-zero true)
// Ignores leading zeros; truthy if any non-zero byte (MSB & 127 for last byte)
fn decode_bool(s: []u8) -> bool {
    if len(s) == 0 {
        return false;
    }
    let mut i: i64 = 0;
    while i < len(s) - 1 {
        if s[i] != 0 {
            return true;
        }
        i += 1;
    }
    return (s[len(s) - 1] & 127) != 0;
}

// Decodes a byte slice to i64 number (LE, sign in MSB)
fn decode_num(s: []u8) -> i64 {
    let high: u8;
    if len(s) == 0 {
        high = 0;
    } else {
        high = s[len(s) - 1];
    }
    let sign: bool = (high & 0x80) != 0;

    // Sign-extend to 8 bytes
    let mut extended: [u8; 8] = [0; 8];
    let mut i: i64 = 0;
    while i < len(s) {
        extended[i] = s[i];
        i += 1;
    }
    while i < 8 {
        if sign {
            extended[i] = 255;
        } else {
            extended[i] = 0;
        }
        i += 1;
    }

    // Convert LE bytes to i64
    let n: i64 = (extended[0] as i64)
        | ((extended[1] as i64) << 8)
        | ((extended[2] as i64) << 16)
        | ((extended[3] as i64) << 24)
        | ((extended[4] as i64) << 32)
        | ((extended[5] as i64) << 40)
        | ((extended[6] as i64) << 48)
        | ((extended[7] as i64) << 56);

    return n;
}

// Encodes i64 to minimal byte slice (1-4 bytes LE, sign in MSB)
fn encode_num(val: i64) -> [u8; 8] {
    let mut result: [u8; 8] = [0; 8];
    let mut out_len: i64 = 0;

    if val == 0 {
        result[0] = 0;
        out_len = 0;
        _ = out_len;
        return result;
    }

    // Get LE bytes of i32
    let low: i32 = val as i32;
    let full: [u8; 4] = [
        (low & 0xFF) as u8,
        ((low >> 8) & 0xFF) as u8,
        ((low >> 16) & 0xFF) as u8,
        ((low >> 24) & 0xFF) as u8,
    ];

    // Find minimal encoding
    let mut l: i64 = 1;
    while l <= 4 {
        let mut test: [u8; 4] = [0; 4];
        let mut ti: i64 = 0;
        while ti < l {
            test[ti] = full[ti];
            ti += 1;
        }

        let high_byte: u8 = test[l - 1];
        let is_neg: bool = (high_byte & 0x80) != 0;

        // Sign-extend test to 4 bytes
        let mut extended: [u8; 4] = [0; 4];
        let mut ei: i64 = 0;
        while ei < l {
            extended[ei] = test[ei];
            ei += 1;
        }
        while ei < 4 {
            if is_neg {
                extended[ei] = 255;
            } else {
                extended[ei] = 0;
            }
            ei += 1;
        }

        // Convert extended back to i32 then i64
        let decoded: i64 = (extended[0] as i64)
            | ((extended[1] as i64) << 8)
            | ((extended[2] as i64) << 16)
            | ((extended[3] as i64) << 24);

        // Sign-extend from i32
        let decoded_i32: i32 = decoded as i32;
        let decoded_i64: i64 = decoded_i32 as i64;

        if decoded_i64 == val {
            // Copy to result
            out_len = l;
            let mut ci: i64 = 0;
            while ci < l {
                result[ci] = test[ci];
                ci += 1;
            }
            return result;
        }
        l += 1;
    }

    // Fallback: direct encoding
    let negative: bool = val < 0;
    let mut abs_n: i64;
    if negative {
        abs_n = -val;
    } else {
        abs_n = val;
    }

    let mut idx: i64 = 0;
    while abs_n > 0 {
        result[idx] = (abs_n & 0xFF) as u8;
        abs_n >>= 8;
        idx += 1;
    }
    out_len = idx;

    if (result[idx - 1] & 0x80) != 0 {
        result[idx] = if negative { 0x80 } else { 0 };
        out_len = idx + 1;
    } else if negative {
        result[idx - 1] |= 0x80;
    }

    return result;
}

// Returns the encoded length for encode_num result
fn encode_num_len(val: i64) -> i64 {
    if val == 0 {
        return 0;
    }

    let negative: bool = val < 0;
    let mut abs_n: i64;
    if negative {
        abs_n = -val;
    } else {
        abs_n = val;
    }

    let mut bytes: [u8; 8] = [0; 8];
    let mut idx: i64 = 0;
    while abs_n > 0 {
        bytes[idx] = (abs_n & 0xFF) as u8;
        abs_n >>= 8;
        idx += 1;
    }

    let last: u8 = bytes[idx - 1];
    if (last & 0x80) != 0 {
        return idx + 1;
    }
    return idx;
}

// Decodes bytes to bigint as i64 (simplified — LE, sign from MSB)
fn decode_bigint(s: []u8) -> i64 {
    if len(s) == 0 {
        return 0;
    }

    let mut result: i64 = 0;
    let mut i: i64 = len(s) - 1;
    while i > 0 {
        result = (result << 8) | (s[i] as i64);
        i -= 1;
    }

    let negative: bool = (s[len(s) - 1] & 0x80) != 0;
    if negative {
        result = (result << 8) | ((s[0] & 0x7F) as i64);
        return -result;
    } else {
        result = (result << 8) | (s[0] as i64);
        return result;
    }
}

// Encodes i64 to minimal byte array (LE bytes, sign in MSB if negative)
// Returns (data, len) via output buffer
fn encode_bigint(n: i64, out: []u8) -> i64 {
    if n == 0 {
        return 0;
    }

    let negative: bool = n < 0;
    let mut abs_n: i64;
    if negative {
        abs_n = -n;
    } else {
        abs_n = n;
    }

    let mut idx: i64 = 0;
    while abs_n > 0 {
        out[idx] = (abs_n & 0xFF) as u8;
        abs_n >>= 8;
        idx += 1;
    }

    if idx > 0 {
        let last_idx: i64 = idx - 1;
        if (out[last_idx] & 0x80) != 0 {
            if negative {
                out[idx] = 0x80;
            } else {
                out[idx] = 0;
            }
            idx += 1;
        } else if negative {
            out[last_idx] |= 0x80;
        }
    }

    return idx;
}
