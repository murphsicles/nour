// op_codes.z — Script opcodes for Bitcoin SV consensus execution
// Constants grouped by category, matching BIP-16/34/65/68/112/143 and BSV Genesis upgrades.

// Pushdata and Constants
const OP_0: u8 = 0;
const OP_FALSE: u8 = 0;
const OP_PUSH: u8 = 0;
const OP_PUSHDATA1: u8 = 76;
const OP_PUSHDATA2: u8 = 77;
const OP_PUSHDATA4: u8 = 78;
