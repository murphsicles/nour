// FeeFilter message for Bitcoin SV P2P, signaling minimum transaction fee.

struct FeeFilter {
    minfee: u64,
}

fn fee_filter_size() -> usize {
    8
}

fn fee_filter_read(data: [u8], offset: usize) -> (FeeFilter, usize) {
    let mut o = offset
    let bytes = data[o..o+8]
    let minfee = (bytes[0] as u64) |
                 ((bytes[1] as u64) << 8) |
                 ((bytes[2] as u64) << 16) |
                 ((bytes[3] as u64) << 24) |
                 ((bytes[4] as u64) << 32) |
                 ((bytes[5] as u64) << 40) |
                 ((bytes[6] as u64) << 48) |
                 ((bytes[7] as u64) << 56)
    o += 8
    (FeeFilter { minfee }, o)
}

fn fee_filter_write(f: FeeFilter) -> [u8] {
    let mut out = [0; 8]
    out[0] = (f.minfee & 0xff) as u8
    out[1] = ((f.minfee >> 8) & 0xff) as u8
    out[2] = ((f.minfee >> 16) & 0xff) as u8
    out[3] = ((f.minfee >> 24) & 0xff) as u8
    out[4] = ((f.minfee >> 32) & 0xff) as u8
    out[5] = ((f.minfee >> 40) & 0xff) as u8
    out[6] = ((f.minfee >> 48) & 0xff) as u8
    out[7] = ((f.minfee >> 56) & 0xff) as u8
    out
}
