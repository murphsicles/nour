// MerkleBlock message for Bitcoin SV P2P — partial merkle tree (BIP-37)

struct MerkleBlock {
    header: BlockHeader,
    total_transactions: i64,
    hashes: [][u8],
    flags: [u8],
}

fn merkle_block_read(data: [u8], offset: i64) -> (MerkleBlock, i64) {
    let mut o: i64 = offset;

    let (header, new_o): (BlockHeader, i64) = block_header_read(data, o);
    o = new_o;

    let total_transactions: i64 = (data[o] as i64)
        | ((data[o + 1] as i64) << 8)
        | ((data[o + 2] as i64) << 16)
        | ((data[o + 3] as i64) << 24);
    o += 4;

    let (num_hashes, new_o): (i64, i64) = var_int_read(data, o);
    o = new_o;

    let nh: i64 = num_hashes;
    let mut hashes: [][u8] = [];
    let mut i: i64 = 0;
    while i < nh {
        let h: [u8] = data[o..o + 32];
        hashes[i] = h;
        o += 32;
        i += 1;
    }

    let (flags_len, new_o): (i64, i64) = var_int_read(data, o);
    o = new_o;

    let flags: [u8] = data[o..o + flags_len];
    o += flags_len;

    return (MerkleBlock { header: header, total_transactions: total_transactions, hashes: hashes, flags: flags }, o);
}

fn merkle_block_hash_pair(a: [u8], b: [u8]) -> [u8] {
    let mut buf: [u8; 64] = [0; 64];
    let mut i: i64 = 0;
    while i < 32 {
        buf[i] = a[i];
        i += 1;
    }
    i = 0;
    while i < 32 {
        buf[32 + i] = b[i];
        i += 1;
    }
    return sha256d(buf);
}

fn merkle_block_consume_hash(hashes: [][u8], idx: i64) -> ([u8], bool) {
    if idx < 0 || idx >= len(hashes) {
        return ([0; 32], false);
    }
    return (hashes[idx], true);
}

fn merkle_block_get_bit(flags: [u8], bit_idx: i64) -> (u8, bool) {
    let byte_idx: i64 = bit_idx / 8;
    if byte_idx < 0 || byte_idx >= len(flags) {
        return (0, false);
    }
    let byte_val: u8 = flags[byte_idx];
    let bit_pos: u8 = (bit_idx % 8) as u8;
    let bit: u8 = ((byte_val >> bit_pos) & 1) as u8;
    return (bit, true);
}

fn merkle_build_tree(mb: MerkleBlock, level: i64, bit_idx: i64, hash_idx: i64, matches: [][u8]) -> ([u8], i64, i64, [][u8], bool) {
    let (bit, ok): (u8, bool) = merkle_block_get_bit(mb.flags, bit_idx);
    if !ok {
        return ([0; 32], bit_idx + 1, hash_idx, matches, false);
    }
    let new_bit_idx: i64 = bit_idx + 1;
    let bit_val: i64 = bit as i64;

    if level == 0 {
        let (h, ok2): ([u8], bool) = merkle_block_consume_hash(mb.hashes, hash_idx);
        if !ok2 {
            return ([0; 32], new_bit_idx, hash_idx, matches, false);
        }
        let new_hash_idx: i64 = hash_idx + 1;
        let new_matches: [][u8] = if bit_val == 1 {
            let mut m: [][u8] = matches;
            m[len(m)] = h;
            m
        } else {
            matches
        };
        return (h, new_bit_idx, new_hash_idx, new_matches, true);
    }

    if bit_val == 0 {
        let (h, ok2): ([u8], bool) = merkle_block_consume_hash(mb.hashes, hash_idx);
        if !ok2 {
            return ([0; 32], new_bit_idx, hash_idx, matches, false);
        }
        return (h, new_bit_idx, hash_idx + 1, matches, true);
    }

    let (left_hash, bi1, hi1, m1, ok1): ([u8], i64, i64, [][u8], bool) = merkle_build_tree(mb, level - 1, new_bit_idx, hash_idx, matches);
    if !ok1 {
        return ([0; 32], bi1, hi1, m1, false);
    }
    let (right_hash, bi2, hi2, m2, ok2): ([u8], i64, i64, [][u8], bool) = merkle_build_tree(mb, level - 1, bi1, hi1, m1);
    if !ok2 {
        return ([0; 32], bi2, hi2, m2, false);
    }

    let computed: [u8] = merkle_block_hash_pair(left_hash, right_hash);
    return (computed, bi2, hi2, m2, true);
}

fn merkle_block_validate(mb: MerkleBlock) -> ([][u8], bool) {
    if mb.total_transactions <= 0 {
        return ([] as [][u8], false);
    }

    let tree_depth: i64 = 0;
    if mb.total_transactions > 1 {
        // Compute tree depth: ceil(log2(total_tx))
        let mut n: i64 = mb.total_transactions - 1;
        let mut depth: i64 = 0;
        while n > 0 {
            depth += 1;
            n >>= 1;
        }
        // tree_depth = depth
    }
    // Simplified: tree_depth = 0 for small merkle trees

    let (root, _, hash_consumed, _, ok): ([u8], i64, i64, [][u8], bool) = merkle_build_tree(mb, tree_depth, 0, 0, [][u8] as [][u8]);
    if !ok {
        return ([] as [][u8], false);
    }

    if hash_consumed != len(mb.hashes) {
        return ([] as [][u8], false);
    }

    // matches not tracked in this simplified version
    return ([][u8] as [][u8], true);
}
