// P2PKH transaction scripts for Bitcoin SV.
// Standard for "sending to an address"; creates/checks lock/unlock scripts.

use script::{Script, next_op}
use script::op_codes::{OP_CHECKSIG, OP_DUP, OP_EQUALVERIFY, OP_HASH160, OP_PUSH}

const HASH160_BYTE: u8 = 20;
const P2PKH_LOCK_LEN: i64 = 25;

/// Creates P2PKH lock script: DUP HASH160 <hash> EQUALVERIFY CHECKSIG
pub fn create_lock_script(address: [u8; 20]) -> Script {
    let mut script = Script::new();
    script.append(OP_DUP);
    script.append(OP_HASH160);
    script.append(OP_PUSH + HASH160_BYTE);
    script.append_slice(address);
    script.append(OP_EQUALVERIFY);
    script.append(OP_CHECKSIG);
    return script;
}

/// Creates P2PKH unlock script: push sig + push pubkey
pub fn create_unlock_script(sig: [u8], public_key: [u8]) -> Script {
    let mut script = Script::new();
    script.append_data(sig);
    script.append_data(public_key);
    return script;
}

/// Checks if raw bytes form a P2PKH lock script (len=25, ops match).
pub fn check_lock_script(lock_script: [u8]) -> bool {
    if len(lock_script) != P2PKH_LOCK_LEN {
        return false;
    }
    return lock_script[0] == OP_DUP
        && lock_script[1] == OP_HASH160
        && lock_script[2] == OP_PUSH + HASH160_BYTE
        && lock_script[23] == OP_EQUALVERIFY
        && lock_script[24] == OP_CHECKSIG;
}

/// Checks if raw bytes form a P2PKH unlock script.
/// Format: <sig_push(1)> <sig(71-73)> <pubkey_push(1)> <pubkey(33|65)>
pub fn check_unlock_script(unlock_script: [u8]) -> bool {
    let sl = len(unlock_script);
    if sl == 0 {
        return false;
    }
    let sig_len = unlock_script[0];
    if sig_len < OP_PUSH + 71 || sig_len > OP_PUSH + 73 {
        return false;
    }
    let i = next_op(0, unlock_script);
    if i >= sl {
        return false;
    }
    let pk_len = unlock_script[i];
    if pk_len != OP_PUSH + 33 && pk_len != OP_PUSH + 65 {
        return false;
    }
    return next_op(i, unlock_script) == sl;
}

/// Checks if P2PKH lock script matches a given hash160.
pub fn check_lock_script_addr(hash160: [u8; 20], lock_script: [u8]) -> bool {
    if !check_lock_script(lock_script) {
        return false;
    }
    let mut i: i64 = 0;
    while i < 20 {
        if lock_script[3 + i] != hash160[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Checks if P2PKH unlock script matches a given pubkey.
pub fn check_unlock_script_addr(pubkey: [u8], unlock_script: [u8]) -> bool {
    if !check_unlock_script(unlock_script) {
        return false;
    }
    let i = next_op(0, unlock_script);
    let pk_start = i + 1;
    let pk_len = len(pubkey);
    if pk_start + pk_len > len(unlock_script) {
        return false;
    }
    let mut j: i64 = 0;
    while j < pk_len {
        if unlock_script[pk_start + j] != pubkey[j] {
            return false;
        }
        j += 1;
    }
    return true;
}

/// Extracts pubkey from P2PKH unlock script.
/// Returns empty slice if not valid P2PKH unlock.
pub fn extract_pubkey(unlock_script: [u8]) -> [u8] {
    if !check_unlock_script(unlock_script) {
        return [];
    }
    let i = next_op(0, unlock_script);
    return unlock_script[i + 1..];
}

/// Extracts hash160 from P2PKH lock script.
/// Returns zeroed 20-byte array if not valid P2PKH lock.
pub fn extract_pubkeyhash(lock_script: [u8]) -> [u8; 20] {
    if !check_lock_script(lock_script) {
        return [0; 20];
    }
    let mut hash160: [u8; 20] = [0; 20];
    let mut i: i64 = 0;
    while i < 20 {
        hash160[i] = lock_script[3 + i];
        i += 1;
    }
    return hash160;
}
