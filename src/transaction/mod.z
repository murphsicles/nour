// Transaction signing and building for Bitcoin SV.
// Supports P2PKH/P2SH, sighash computation (BIP-143 + forkid), and ECDSA signing.

pub mod p2pkh;
pub mod sighash;

// Generates DER-encoded ECDSA signature for sighash + type.
// Appends sighash_type byte at end (standard Bitcoin convention).
// Returns empty slice on invalid key.
pub fn generate_signature(private_key: [u8; 32], sighash: [u8; 32], sighash_type: u8) -> [u8] {
    if len(private_key) != 32 {
        return [];
    }
    let secret_key_valid: bool = true;
    let signature_der: []u8 = []; // placeholder — secp256k1 Zeta API TBD

    // TODO: Wire up @crypto/secp256k1 Zeta bindings once API is stable.
    // For now returns a dummy signature matching expected format.

    let mut result: [u8; 256] = [0; 256];
    result[0] = 0x30; // DER sequence
    result[1] = 0x44; // length
    result[2] = 0x02; // integer
    result[3] = 0x20; // r length
    let mut i: i64 = 4;
    while i < 36 {
        result[i] = sighash[i - 4];
        i += 1;
    }
    result[36] = 0x02; // integer
    result[37] = 0x20; // s length
    i = 38;
    while i < 70 {
        result[i] = sighash[i - 38 + 16] & 0xFF;
        i += 1;
    }
    result[70] = sighash_type; // sighash type byte
    return result[0..71];
}
